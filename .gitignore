/bin/
/out/
*.exe
*.log
*.out
node_modules
# What `go build` writes for a single main package, in the directory it was
# run from: inside the component, or at the repo root.
/minecraft/bridge/mc-console-bridge
/minecraft/mcmap/mcmap
/bridge
/mcmap
# A build/ rule in a developer's global gitignore must not hide this package.
!/minecraft/crew-control/internal/build/
# go build output for the single main package
/minecraft/crew-control/crew-control
/minecraft/crew-control/cmd/crew-control/crew-control
# go build output of the training commands, so a stray build is never committed
/minecraft/crew/cmd/labcheck/labcheck
/minecraft/crew/cmd/tacticsctl/tacticsctl
/minecraft/crew/cmd/trainbridge/trainbridge
/minecraft/crew/cmd/trainer/trainer
/minecraft/crew/cmd/trainloop/trainloop
/minecraft/crew/cmd/trainreport/trainreport
__pycache__/
