{
  "format_version": "1.8.0",
  "animations": {
    "animation.gameops.colossus.walk": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * 50.0 * query.modified_move_speed", 0, 0] },
        "left_leg": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * -50.0 * query.modified_move_speed", 0, 0] },
        "right_arm": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * -35.0 * query.modified_move_speed", 0, 0] },
        "left_arm": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * 35.0 * query.modified_move_speed", 0, 0] }
      }
    },
    "animation.gameops.colossus.attack": {
      "loop": true,
      "bones": {
        "right_arm": { "rotation": ["-110.0 * math.sin(variable.attack_time * 180.0)", 0, "-20.0 * math.sin(variable.attack_time * 180.0)"] },
        "left_arm": { "rotation": ["-110.0 * math.sin(variable.attack_time * 180.0)", 0, "20.0 * math.sin(variable.attack_time * 180.0)"] },
        "head": { "rotation": ["20.0 * math.sin(variable.attack_time * 180.0)", 0, 0] }
      }
    },
    "animation.gameops.colossus.look": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["math.clamp(query.target_x_rotation, -30.0, 30.0)", "math.clamp(query.target_y_rotation, -60.0, 60.0)", 0] }
      }
    }
  }
}
