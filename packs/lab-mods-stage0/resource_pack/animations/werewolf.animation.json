{
  "format_version": "1.8.0",
  "animations": {
    "animation.gameops.werewolf.walk": {
      "loop": true,
      "bones": {
        "right_leg": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * 60.0 * query.modified_move_speed", 0, 0] },
        "left_leg": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * -60.0 * query.modified_move_speed", 0, 0] },
        "right_arm": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * -50.0 * query.modified_move_speed", 0, 0] },
        "left_arm": { "rotation": ["math.cos(query.modified_distance_moved * 24.0) * 50.0 * query.modified_move_speed", 0, 0] }
      }
    },
    "animation.gameops.werewolf.attack": {
      "loop": true,
      "bones": {
        "right_arm": { "rotation": ["-100.0 * math.sin(variable.attack_time * 180.0)", 0, "-25.0 * math.sin(variable.attack_time * 180.0)"] },
        "left_arm": { "rotation": ["-100.0 * math.sin(variable.attack_time * 180.0)", 0, "25.0 * math.sin(variable.attack_time * 180.0)"] },
        "head": { "rotation": ["25.0 * math.sin(variable.attack_time * 180.0)", 0, 0] }
      }
    },
    "animation.gameops.werewolf.look": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["math.clamp(query.target_x_rotation, -30.0, 30.0)", "math.clamp(query.target_y_rotation, -60.0, 60.0)", 0] },
        "tail": { "rotation": [0, "math.sin(query.life_time * 240.0) * 18.0", 0] }
      }
    }
  }
}
