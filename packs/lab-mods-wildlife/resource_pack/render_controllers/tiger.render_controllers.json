{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.gameops.tiger": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "collar": "query.property('gameops:tamed')"
        }
      ],
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.orange",
            "Texture.white"
          ]
        }
      },
      "textures": [
        "Array.skins[query.variant]"
      ]
    }
  }
}
