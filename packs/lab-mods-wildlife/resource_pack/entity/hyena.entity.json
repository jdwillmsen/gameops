{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gameops:hyena",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "regular": "textures/entity/hyena_regular",
        "alpha": "textures/entity/hyena_alpha",
        "armor_leather": "textures/entity/hyena_armor_leather",
        "armor_iron": "textures/entity/hyena_armor_iron",
        "armor_diamond": "textures/entity/hyena_armor_diamond"
      },
      "geometry": {
        "default": "geometry.gameops.hyena",
        "armor": "geometry.gameops.hyena_armor"
      },
      "animations": {
        "walk": "animation.gameops.cat.walk",
        "sit": "animation.gameops.cat.sit",
        "idle": "animation.gameops.cat.idle",
        "attack": "animation.gameops.cat.attack"
      },
      "scripts": {
        "scale": "query.is_baby ? 0.5 : 1.0",
        "animate": [
          "walk",
          "idle",
          {
            "sit": "query.is_sitting"
          },
          {
            "attack": "variable.attack_time > 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.gameops.hyena",
        {
          "controller.render.gameops.hyena_armor": "query.property('gameops:armor') > 0"
        }
      ],
      "spawn_egg": {
        "base_color": "#b59a62",
        "overlay_color": "#3a2e1a"
      }
    }
  }
}
